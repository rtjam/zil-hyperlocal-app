# ZiL — Supabase + PostGIS & Turkish SMS OTP Configuration
# Copy this file to .env.local to connect to your live Supabase instance.
# Without these keys, ZiL automatically runs on its built-in persistent local database (data/zil-db.json).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Netgsm / Twilio SMS OTP Gateway for +90 Verification
NETGSM_USERCODE=850xxxxxxx
NETGSM_PASSWORD=your-netgsm-password
